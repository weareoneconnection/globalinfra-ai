FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 globalinfra

# Keep release-specific metadata after the dependency layer so every commit
# can reuse the pinned Python environment while its own evidence is still
# validated in a later, uncached layer.
ARG SOURCE_COMMIT
ARG EVIDENCE_SHA256
ARG BUILD_DATE

LABEL org.opencontainers.image.title="GlobalInfra AI API"
LABEL org.opencontainers.image.source="https://github.com/weareoneconnection/globalinfra-ai"
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL ai.globalinfra.release-evidence.sha256="${EVIDENCE_SHA256}"

COPY app ./app
COPY evals ./evals
COPY alembic.ini ./
COPY migrations ./migrations

# This file is generated and signed in the protected release-signing GitHub
# Environment before the image is built. It is root-owned and the runtime runs
# as a non-root user, so an application process cannot replace the evidence it
# is expected to verify.
COPY evidence/release-evidence.json /run/globalinfra-evidence/release-evidence.json
RUN python -c \
      'import hashlib, json, pathlib, re, sys; source, expected, filename = sys.argv[1:]; data = pathlib.Path(filename).read_bytes(); actual = hashlib.sha256(data).hexdigest(); envelope = json.loads(data); payload = envelope.get("payload") or {}; signature = envelope.get("signature") or {}; evidence_source = payload.get("source") or {}; assert re.fullmatch(r"[0-9a-f]{40,64}", source), "invalid SOURCE_COMMIT"; assert re.fullmatch(r"[0-9a-f]{64}", expected), "invalid EVIDENCE_SHA256"; assert actual == expected, f"release evidence hash mismatch: {actual}"; assert evidence_source.get("commit") == source, "release evidence commit mismatch"; assert evidence_source.get("dirty") is False, "release evidence source is dirty"; assert signature.get("scheme") == "ED25519" and signature.get("key_id") and signature.get("value"), "release evidence must carry an Ed25519 signature"' \
      "$SOURCE_COMMIT" "$EVIDENCE_SHA256" /run/globalinfra-evidence/release-evidence.json \
    && chown -R globalinfra:globalinfra /app \
    && chown -R root:root /run/globalinfra-evidence \
    && chmod 0555 /run/globalinfra-evidence \
    && chmod 0444 /run/globalinfra-evidence/release-evidence.json

ENV RELEASE_EVIDENCE_PATH=/run/globalinfra-evidence/release-evidence.json
ENV GIT_COMMIT_SHA=${SOURCE_COMMIT}

USER globalinfra
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
