POSTGRES_DB=globalinfra
POSTGRES_USER=globalinfra
POSTGRES_PASSWORD=globalinfra
DATABASE_URL=postgresql+psycopg://globalinfra:globalinfra@postgres:5432/globalinfra
REDIS_URL=redis://redis:6379/0
API_INTERNAL_URL=http://api:8000
LLM_MODE=mock
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-5.6-mini
# Pilot-stage auth gate (see docs/SECURITY.md). Off by default so the
# competition/demo flow needs no credential. Set REQUIRE_API_KEY=true and a
# non-empty API_KEY before exposing the API outside a trusted network; this
# is a stopgap, not a replacement for the SSO/OIDC backlog item.
REQUIRE_API_KEY=false
API_KEY=
# Server-only credential used by the Next.js backend proxy when the API gate
# is enabled. In deployment, set this to the same secret as API_KEY. Never
# expose it through a NEXT_PUBLIC_* variable.
API_SERVICE_KEY=
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Maximum accepted intake upload size in bytes (default: 10 MiB).
MAX_UPLOAD_BYTES=10485760
