POSTGRES_DB=globalinfra
POSTGRES_USER=globalinfra
POSTGRES_PASSWORD=globalinfra
DATABASE_URL=postgresql+psycopg://globalinfra:globalinfra@postgres:5432/globalinfra
REDIS_URL=redis://redis:6379/0
API_INTERNAL_URL=http://api:8000
LLM_MODE=mock
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-5.6-mini
# Local Ollama override (used by docker-compose.local-llm.yml).
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen3:8b
# With LLM_MODE=auto, normal requests use this provider first. Restricted
# requests always stay local regardless of this preference.
LLM_PREFERRED_PROVIDER=local
LLM_CLOUD_FALLBACK_ENABLED=true
# Phase 7 identity mode: disabled (public demo), api_key (controlled pilot),
# or oidc (production). REQUIRE_API_KEY remains a backwards-compatible switch.
AUTH_MODE=disabled
REQUIRE_API_KEY=false
API_KEY=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_ORGANIZATION_CLAIM=org_id
OIDC_PROJECTS_CLAIM=projects
DEFAULT_ORGANIZATION_ID=globalinfra-demo
AUDIT_MUTATIONS=true
RATE_LIMIT_PER_MINUTE=180
CONNECTOR_WEBHOOK_SECRET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=globalinfra-field
TELEMETRY_STALE_SECONDS=300
# Server-only credential used by the Next.js backend proxy when the API gate
# is enabled. In deployment, set this to the same secret as API_KEY. Never
# expose it through a NEXT_PUBLIC_* variable.
API_SERVICE_KEY=
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Maximum accepted intake upload size in bytes (default: 10 MiB).
MAX_UPLOAD_BYTES=10485760
