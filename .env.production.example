# Production configuration template.
# Replace every REPLACE_* value through the deployment secret manager; never
# commit real credentials or copy a local .env into this file.

# API service
PORT=8000
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
REDIS_URL=redis://REDIS_HOST:6379/0
LLM_MODE=mock
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-5.6-mini
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=qwen3:8b
LLM_PREFERRED_PROVIDER=local
LLM_CLOUD_FALLBACK_ENABLED=false

# Authentication and authorization. Use oidc for a production pilot.
AUTH_MODE=oidc
API_AUTH_MODE=oidc
REQUIRE_API_KEY=true
API_KEY=REPLACE_WITH_API_SERVICE_KEY
OIDC_ISSUER=https://login.example.com/REPLACE_TENANT
OIDC_AUDIENCE=REPLACE_API_AUDIENCE
OIDC_JWKS_URL=https://login.example.com/REPLACE_TENANT/.well-known/jwks.json
OIDC_ROLES_CLAIM=roles
OIDC_ORGANIZATION_CLAIM=org_id
OIDC_PROJECTS_CLAIM=projects
DEFAULT_ORGANIZATION_ID=REPLACE_ORGANIZATION_ID
AUDIT_MUTATIONS=true
RATE_LIMIT_PER_MINUTE=180

# Integration and storage boundaries
CONNECTOR_WEBHOOK_SECRET=REPLACE_CONNECTOR_WEBHOOK_SECRET
OBJECT_STORAGE_ENDPOINT=https://REPLACE_OBJECT_STORAGE_ENDPOINT
OBJECT_STORAGE_BUCKET=globalinfra-field
TELEMETRY_STALE_SECONDS=300
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=https://REPLACE_WEB_DOMAIN

# V6 governed judge sandbox and signed evidence. Keep the sandbox on a
# synthetic-only service/database; never reuse a pilot database here.
COMPETITION_V6_ENABLED=true
COMPETITION_SESSION_TTL_MINUTES=30
COMPETITION_SIGNING_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
AUDIT_SIGNING_KEY=REPLACE_WITH_SEPARATE_32_BYTE_AUDIT_RECEIPT_KEY
AUDIT_SIGNING_KEY_ID=audit-2026-11
# Verification-only retired keys; remove only after the governed retention window.
AUDIT_VERIFICATION_KEYS={}
# Runtime gets only the Ed25519 public key. Keep
# EVIDENCE_SIGNING_PRIVATE_KEY exclusively in the CI/KMS secret store.
EVIDENCE_VERIFICATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ED25519_PUBLIC_KEY_BASE64\n-----END PUBLIC KEY-----"
EVIDENCE_ALLOW_LEGACY_HMAC=false
EVIDENCE_SIGNING_KEY=
RELEASE_EVIDENCE_PATH=/var/run/globalinfra-evidence/release-evidence.json
GIT_COMMIT_SHA=REPLACE_WITH_DEPLOYED_COMMIT_SHA
SOD_ENFORCED=true
EVIDENCE_BUNDLE_REQUIRED=true
SANDBOX_MODE=true

# Production readiness / residency policy. These values are surfaced as
# declared controls; deployment verification must still supply evidence.
QUEUE_URL=redis://REDIS_HOST:6379/1
DATA_RESIDENCY_REGION=REPLACE_APPROVED_REGION
BACKUP_RETENTION_DAYS=30
RECOVERY_POINT_OBJECTIVE_MINUTES=15
RECOVERY_TIME_OBJECTIVE_MINUTES=60
COUNTRY_PACK_REVIEW_MAX_AGE_DAYS=180

# Web service (set PORT=3000 on the Web service; do not expose these through
# browser-exposed NEXT_PUBLIC_* variables).
API_INTERNAL_URL=http://api.internal:8000
API_SERVICE_KEY=REPLACE_WITH_API_SERVICE_KEY
OIDC_CLIENT_ID=REPLACE_WEB_OIDC_CLIENT_ID
# Leave empty for a registered public PKCE client.
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_ENDPOINT=https://login.example.com/REPLACE_TENANT/authorize
OIDC_TOKEN_ENDPOINT=https://login.example.com/REPLACE_TENANT/token
OIDC_REDIRECT_URI=https://REPLACE_WEB_DOMAIN/auth/callback
OIDC_SCOPES=openid profile email
WEB_SESSION_SECRET=REPLACE_WITH_SEPARATE_32_BYTE_WEB_SESSION_SECRET
